'use strict';
// Optional dynamic assessment selection. Existing official merit routes remain untouched.
const express=require('express'),db=require('../db');
const {authenticate,schoolBoundary,roles}=require('../middleware/auth');
const {calculate}=require('../services/merit-flex-engine');
const router=express.Router();router.use(authenticate);
const view=roles('SCHOOL_ADMIN','ADMIN','HEADTEACHER','DEPUTY_HEADTEACHER','SENIOR_TEACHER','CLASS_TEACHER','TEACHER');
const edit=roles('SCHOOL_ADMIN','ADMIN','HEADTEACHER');
const uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
function validContext(sid,q){return [sid,q.academic_year_id,q.term_id,q.class_id].every(v=>uuid.test(String(v||'')));}
async function scope(sid,q){const r=await db.query('SELECT 1 FROM classes c JOIN academic_years y ON y.school_id=c.school_id AND y.id=$2 JOIN terms t ON t.school_id=c.school_id AND t.academic_year_id=y.id AND t.id=$3 WHERE c.school_id=$1 AND c.id=$4',[sid,q.academic_year_id,q.term_id,q.class_id]);return !!r.rowCount;}
async function teacherAccess(req,sid,q){if(req.user.role!=='CLASS_TEACHER'&&req.user.role!=='TEACHER')return true;const r=await db.query('SELECT 1 FROM class_teacher_assignments a JOIN teachers th ON th.id=a.teacher_id WHERE a.school_id=$1 AND a.class_id=$2 AND a.academic_year_id=$3 AND th.user_id=$4 LIMIT 1',[sid,q.class_id,q.academic_year_id,req.user.user_id]);return !!r.rowCount;}
function fail(res,e){res.status(e.status||500).json({error:e.status?e.message:'Unable to process flexible merit.',detail:process.env.NODE_ENV==='production'?undefined:e.message});}
router.get('/:schoolId/setup',schoolBoundary,view,async(req,res)=>{try{const sid=req.params.schoolId,q=req.query;if(!validContext(sid,q))return res.status(400).json({error:'Select school, year, term and class.'});if(!await scope(sid,q))return res.status(404).json({error:'Invalid class or academic context.'});if(!await teacherAccess(req,sid,q))return res.status(403).json({error:'Class not assigned.'});const a=await db.query('SELECT id,name,assessment_type,max_mark,class_id,subject_id FROM assessments WHERE school_id=$1 AND academic_year_id=$2 AND term_id=$3 AND (class_id IS NULL OR class_id=$4) ORDER BY assessment_order NULLS LAST,name,id',[sid,q.academic_year_id,q.term_id,q.class_id]);const p=await db.query('SELECT selected_assessment_ids,cat_group_mode,custom_weights FROM merit_flex_profiles WHERE school_id=$1 AND academic_year_id=$2 AND term_id=$3 AND class_id=$4',[sid,q.academic_year_id,q.term_id,q.class_id]);res.json({assessments:a.rows,profile:p.rows[0]||null});}catch(e){fail(res,e)}});
router.put('/:schoolId/profile',schoolBoundary,edit,async(req,res)=>{try{const sid=req.params.schoolId,q=req.body;if(!validContext(sid,q))return res.status(400).json({error:'Select school, year, term and class.'});if(!await scope(sid,q))return res.status(404).json({error:'Invalid class or academic context.'});const ids=q.selected_assessment_ids,mode=q.cat_group_mode;if(!Array.isArray(ids)||!ids.length||ids.length>100||!ids.every(id=>uuid.test(String(id)))||new Set(ids).size!==ids.length||!['INDIVIDUAL','CAT_GROUP','CUSTOM'].includes(mode))return res.status(400).json({error:'Select valid assessments and averaging method.'});const weights=q.custom_weights||{};if(mode==='CUSTOM'&&(!weights||typeof weights!=='object'||Array.isArray(weights)||Object.keys(weights).length!==ids.length||ids.some(id=>!Object.prototype.hasOwnProperty.call(weights,id)||!Number.isFinite(Number(weights[id]))||Number(weights[id])<0||Number(weights[id])>100)||Math.abs(ids.reduce((n,id)=>n+Number(weights[id]),0)-100)>.02))return res.status(400).json({error:'Custom assessment weights must total 100%.'});const a=await db.query('SELECT id FROM assessments WHERE school_id=$1 AND academic_year_id=$2 AND term_id=$3 AND (class_id IS NULL OR class_id=$4) AND id=ANY($5::uuid[])',[sid,q.academic_year_id,q.term_id,q.class_id,ids]);if(a.rowCount!==ids.length)return res.status(400).json({error:'One or more assessments are outside this school, class or term.'});const saved=await db.query(`INSERT INTO merit_flex_profiles(school_id,academic_year_id,term_id,class_id,selected_assessment_ids,cat_group_mode,custom_weights) VALUES($1,$2,$3,$4,$5::jsonb,$6,$7::jsonb) ON CONFLICT(school_id,academic_year_id,term_id,class_id) DO UPDATE SET selected_assessment_ids=excluded.selected_assessment_ids,cat_group_mode=excluded.cat_group_mode,custom_weights=excluded.custom_weights,updated_at=now() RETURNING *`,[sid,q.academic_year_id,q.term_id,q.class_id,JSON.stringify(ids),mode,JSON.stringify(mode==='CUSTOM'?weights:{})]);res.json({profile:saved.rows[0]});}catch(e){fail(res,e)}});
router.get('/:schoolId/preview',schoolBoundary,view,async(req,res)=>{try{const sid=req.params.schoolId,q=req.query;if(!validContext(sid,q))return res.status(400).json({error:'Select school, year, term and class.'});if(!await scope(sid,q))return res.status(404).json({error:'Invalid class or academic context.'});if(!await teacherAccess(req,sid,q))return res.status(403).json({error:'Class not assigned.'});const profile=(await db.query('SELECT selected_assessment_ids,cat_group_mode,custom_weights FROM merit_flex_profiles WHERE school_id=$1 AND academic_year_id=$2 AND term_id=$3 AND class_id=$4',[sid,q.academic_year_id,q.term_id,q.class_id])).rows[0];if(!profile)return res.status(409).json({error:'Save selected assessments first.'});const ids=profile.selected_assessment_ids;if(!Array.isArray(ids)||!ids.length)return res.status(409).json({error:'No assessments selected.'});const all=(await db.query('SELECT id,name,assessment_type,class_id,subject_id FROM assessments WHERE school_id=$1 AND academic_year_id=$2 AND term_id=$3 AND (class_id IS NULL OR class_id=$4) AND id=ANY($5::uuid[])',[sid,q.academic_year_id,q.term_id,q.class_id,ids])).rows;if(all.length!==ids.length)return res.status(409).json({error:'Selected assessments have changed. Update the profile.'});const cats=all.filter(a=>/CAT|CONTINUOUS/i.test(String(a.assessment_type)+' '+a.name)).map(a=>String(a.id));const subjects=(await db.query('SELECT DISTINCT subject_id FROM teacher_subject_assignments WHERE school_id=$1 AND academic_year_id=$2 AND class_id=$3 AND (term_id=$4 OR term_id IS NULL)',[sid,q.academic_year_id,q.class_id,q.term_id])).rows.map(r=>String(r.subject_id));if(!subjects.length)return res.status(409).json({error:'Assign subjects to the class first.'});const learners=(await db.query(`SELECT l.id learner_id,l.admission_no,l.first_name,l.last_name FROM learners l JOIN learner_enrollments le ON le.learner_id=l.id AND le.school_id=l.school_id AND le.academic_year_id=$2 WHERE l.school_id=$1 AND le.class_id=$3 AND COALESCE(le.status,'ACTIVE') IN ('ACTIVE','COMPLETED')`,[sid,q.academic_year_id,q.class_id])).rows;const marks=learners.length?(await db.query('SELECT m.learner_id,m.subject_id,m.assessment_id,m.mark,a.max_mark FROM marks m JOIN assessments a ON a.id=m.assessment_id AND a.school_id=m.school_id WHERE m.school_id=$1 AND m.academic_year_id=$2 AND m.term_id=$3 AND m.learner_id=ANY($4::uuid[]) AND m.subject_id=ANY($5::uuid[]) AND m.assessment_id=ANY($6::uuid[])',[sid,q.academic_year_id,q.term_id,learners.map(l=>l.learner_id),subjects,ids])).rows:[];const grouped=new Map();for(const m of marks){const k=String(m.learner_id);if(!grouped.has(k))grouped.set(k,[]);const max=Number(m.max_mark);grouped.get(k).push({subject_id:m.subject_id,assessment_id:m.assessment_id,percent:m.mark==null||!Number.isFinite(max)||max<=0?null:Number(m.mark)/max*100});}const rows=calculate(learners.map(l=>({...l,marks:grouped.get(String(l.learner_id))||[]})),subjects,ids,profile.cat_group_mode,cats,profile.custom_weights||{});res.json({basis:'FLEXIBLE_TERM_PREVIEW',official:false,selected_assessments:all,cat_group_mode:profile.cat_group_mode,rows,summary:{learners:rows.length,complete:rows.filter(r=>r.complete).length,incomplete:rows.filter(r=>!r.complete).length}});}catch(e){fail(res,e)}});
module.exports=router;
